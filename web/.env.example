# Copy to .env.local for `npm run dev` (git-ignored). The frontend only needs to know where the API is.
# Local: the API from ../api running with `npm run dev`. Production builds get it from the deploy workflow.
NEXT_PUBLIC_API_URL=http://localhost:8787
# Shown in the header and on the sign-in page
NEXT_PUBLIC_APP_NAME=Gold Predictor
