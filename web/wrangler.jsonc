{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The frontend: static files only (no server code). The backend API is the separate Worker in ../api.
	"name": "gold-predictor",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./out",
		// /logs serves out/logs.html; unknown paths get out/404.html
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
