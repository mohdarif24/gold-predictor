# Copy to .env for LOCAL runs (never commit it). In production these live in GitHub Actions secrets.
# Everything is optional locally; without DATABASE_URL a SQLite file (store/predictor.db) is used.

# Neon / Postgres connection string
DATABASE_URL=

# MT5 auto-login (Windows only, use a DEMO account first)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Telegram alerts: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

# AI model for news headlines (optional). The super admin can also set it on the website's Model API page;
# SETTINGS_KEY must then match the website's secret so the saved key can be decrypted here.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
SETTINGS_KEY=

# Email alerts (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
